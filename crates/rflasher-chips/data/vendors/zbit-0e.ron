// Zbit Semiconductor SPI Flash Chips
// Manufacturer id 0x0E: the same ZB25VQ family also answers with 0x5E (see zbit.ron).

(
    vendor: "Zbit",
    manufacturer_id: 0x0E,
    chips: [
        (
            name: "ZB25VQ16",
            device_id: 0x4015,
            total_size: MiB(2),
            features: (wrsr_wren: true, wrsr_ewsr: true),
            voltage: (min: 2700, max: 3600),
            erase_blocks: [
                (opcode: 0x20, regions: [(size: KiB(4), count: 512)]),
                (opcode: 0x52, regions: [(size: KiB(32), count: 64)]),
                (opcode: 0xD8, regions: [(size: KiB(64), count: 32)]),
                (opcode: 0x60, regions: [(size: MiB(2), count: 1)]),
                (opcode: 0xC7, regions: [(size: MiB(2), count: 1)]),
            ],
        ),
    ],
)
